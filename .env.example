# ==============================================================================
# Notes For Me - Environment Variables & Secrets Template
# Copy this file to .env (git-ignored) for local development and CI/CD reference.
# ==============================================================================

# 1. Google OAuth 2.0 & Drive API Configuration (--dart-define / AuthConfig)
GOOGLE_PROJECT_ID=aldavelabs
GOOGLE_CLIENT_ID=702325277685-n5dbp1jhf9i14prhtbtusc40apto0r3h.apps.googleusercontent.com
GOOGLE_SERVER_CLIENT_ID=
GOOGLE_DESKTOP_CLIENT_ID=702325277685-1dg53pr10l0n8tc2ftug9agqfv840h9h.apps.googleusercontent.com
GOOGLE_DESKTOP_CLIENT_SECRET=

# 2. Google Drive Release Hosting (CI/CD & In-App Updates — 0 MB GitHub Storage)
# Generate locally via: python3 scripts/gdrive_release.py setup-oauth
GDRIVE_REFRESH_TOKEN=
GDRIVE_CLIENT_ID=702325277685-n5dbp1jhf9i14prhtbtusc40apto0r3h.apps.googleusercontent.com
GDRIVE_CLIENT_SECRET=
GDRIVE_SERVICE_ACCOUNT_JSON=

# Optional target Drive folder & manifest IDs (auto-created as "Notes For Me Releases" if blank)
GDRIVE_RELEASE_FOLDER_ID=
GDRIVE_MANIFEST_FILE_ID=
GDRIVE_API_KEY=
GDRIVE_PUBLIC_RELEASES=true

# 3. Internal Release Portal & Download Page
RELEASE_PORTAL_HOSTNAME=notes.aldavelabs.com
RELEASE_PORTAL_URL=https://notes.aldavelabs.com
VPN_GATEWAY=10.8.0.1

# 4. GitHub Actions Runner
RUNNER_LABEL=ubuntu-latest

# 5. Android Release Keystore & Signing
ANDROID_PACKAGE_NAME=com.aldavelabs.notes_for_me
ANDROID_KEYSTORE_PATH=
ANDROID_KEYSTORE_PASSWORD=
ANDROID_KEY_ALIAS=notesforme
ANDROID_KEY_PASSWORD=
ANDROID_KEYSTORE_BASE64=

# 6. Optional GitHub Token (Do NOT prefix with GITHUB_)
GH_TOKEN=a
